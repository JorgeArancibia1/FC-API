generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  developer // Único email autorizado (cristobal@gmail.com). Acceso total + panel avanzado.
  admin     // Gestiona partidos, usuarios e invitaciones.
  usuario   // Juega: se inscribe, invita a sus partidos, cambia su rol desde el perfil.
}

enum MatchStatus {
  open       // Acepta inscripciones
  closed     // Cupo lleno o cerrado manualmente
  cancelled  // Cancelado por admin
  finished   // Partido jugado
}

// ============================================================================
// USUARIO Y AUTENTICACION
// ============================================================================

model User {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  lastName        String?    // Apellido
  jerseyName      String?    // Nombre que aparece en la camiseta
  preferredNumber Int?       // Número de jugador preferido
  photoUrl        String?    // URL de foto de perfil (avatar chico) — /uploads/players/...
  heroPhotoUrl    String?    // URL de foto hero (cuerpo entero, aspect 9:16) — /uploads/heroes/...
  email           String     @unique
  password        String
  roles           UserRole[] @default([usuario])
  status          String     @default("activo")

  // Recuperación / identidad
  phone               String?   // Teléfono para el flujo "olvidé mi correo"
  securityQuestion    String?   // Pregunta de seguridad (texto)
  securityAnswerHash  String?   // SHA-256 del answer normalizado (nunca en claro)
  resetTokenHash      String?   // SHA-256 del token de recuperación de contraseña
  resetTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens  RefreshToken[]
  registrations  MatchRegistration[]
  matchesCreated Match[]             @relation("MatchCreatedBy")
  invitesCreated MatchInvite[]       @relation("InviteCreatedBy")
  platformInvitesCreated PlatformInvite[] @relation("PlatformInviteCreatedBy")
}

// OAuth 2.0 refresh token rotation con jti único + reuse detection.
model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  jti       String   @unique
  userId    String   @db.ObjectId
  token     String   @unique // Hash bcrypt del refresh token completo
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ============================================================================
// PARTIDOS
// ============================================================================

model Match {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  place           String      // Lugar del partido (ej: "Centro deportivo Laurita Vicuña")
  dateTime        DateTime    // Fecha y hora del partido
  requiredPlayers Int         // Cupo total (ej: 14 = 7 por equipo)
  notes           String?     // Notas opcionales del admin
  status          MatchStatus @default(open)

  createdById String @db.ObjectId
  createdBy   User   @relation("MatchCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)

  registrations MatchRegistration[]
  invites       MatchInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dateTime])
  @@index([status])
  @@index([createdById])
}

// Invitación compartible a un partido: link (token) + código de 6 dígitos.
// Válida 48 h y reutilizable hasta que expira o se revoca.
model MatchInvite {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  matchId     String   @db.ObjectId
  createdById String   @db.ObjectId
  code        String // 6 dígitos
  token       String   @unique // identificador del link compartible
  expiresAt   DateTime
  uses        Int      @default(0)
  revoked     Boolean  @default(false)
  // Usuarios que aceptaron esta invitación (link o código). Permite atribuir
  // al invitador los usuarios que trajo, para la pestaña "Usuarios" del panel.
  acceptedByIds String[] @default([]) @db.ObjectId
  createdAt   DateTime @default(now())

  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)

  @@index([matchId])
  @@index([code])
  @@index([createdById])
  @@map("match_invites")
}

// Invitación general a la plataforma (no ligada a un partido): link (token) +
// código de 6 dígitos. Permite que un nuevo usuario se registre y quede
// atribuido al invitador para la pestaña "Usuarios". Válida 48 h y reutilizable.
model PlatformInvite {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  createdById String   @db.ObjectId
  code        String // 6 dígitos
  token       String   @unique // identificador del link compartible
  expiresAt   DateTime
  uses        Int      @default(0)
  revoked     Boolean  @default(false)
  // Usuarios que se registraron con esta invitación (link o código). Permite
  // atribuir al invitador los usuarios que trajo, para la pestaña "Usuarios".
  acceptedByIds String[] @default([]) @db.ObjectId
  createdAt   DateTime @default(now())

  createdBy User @relation("PlatformInviteCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)

  @@index([code])
  @@index([createdById])
  @@map("platform_invites")
}

model MatchRegistration {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  matchId      String   @db.ObjectId
  userId       String   @db.ObjectId
  registeredAt DateTime @default(now())
  position     Int?     // Posición manual asignada por admin. null = orden por registeredAt.

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId]) // Un jugador no puede inscribirse 2 veces al mismo partido
  @@index([matchId])
  @@index([userId])
  @@map("match_registrations")
}
